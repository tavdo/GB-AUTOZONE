// GB Autozone — Turso (libSQL / SQLite) via Prisma 7
// Connection URL lives in prisma.config.ts / env (TURSO_DATABASE_URL)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  customer
  admin
}

enum CarStatus {
  available
  reserved
  sold
}

enum Currency {
  GEL
  USD
}

enum OrderStatus {
  pending
  paid
  processing
  shipped
  customs
  delivered
  cancelled
}

enum OrderItemType {
  car
  part
}

enum InquiryType {
  car
  part
  custom
}

enum InquiryStatus {
  new
  in_progress
  quoted
  closed
}

enum ImageOwnerType {
  car
  part
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String?
  passwordHash String?
  role         UserRole @default(customer)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders    Order[]
  favorites Favorite[]
  accounts  Account[]
  sessions  Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Car {
  id            String    @id @default(cuid())
  make          String
  model         String
  year          Int
  vin           String?   @unique
  mileage       Int
  price         Float
  currency      Currency  @default(USD)
  damageType    String?
  auctionSource String?
  auctionLot    String?
  location      String?
  /// i18n: { ka: string, en: string, ru: string }
  description   Json
  status        CarStatus @default(available)
  featured      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  images Image[]

  @@index([make, model, year])
  @@index([status, createdAt])
  @@index([price])
}

model Part {
  id               String   @id @default(cuid())
  sku              String   @unique
  /// i18n: { ka: string, en: string, ru: string }
  name             Json
  category         String
  /// string[]
  compatibleMakes  Json
  /// string[]
  compatibleModels Json
  /// number[]
  compatibleYears  Json
  oemNumber        String?
  price            Float
  currency         Currency @default(USD)
  stockQty         Int      @default(0)
  /// i18n: { ka: string, en: string, ru: string }
  description      Json
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  images Image[]

  @@index([category])
  @@index([oemNumber])
  @@index([sku])
}

model Image {
  id        String         @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int            @default(0)
  ownerType ImageOwnerType
  carId     String?
  partId    String?
  createdAt DateTime       @default(now())

  car  Car?  @relation(fields: [carId], references: [id], onDelete: Cascade)
  part Part? @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([carId])
  @@index([partId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  status          OrderStatus @default(pending)
  totalAmount     Float
  currency        Currency    @default(USD)
  shippingAddress Json?
  customerEmail   String?
  customerPhone   String?
  customerName    String?
  stripeSessionId String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([status, createdAt])
}

model OrderItem {
  id        String        @id @default(cuid())
  orderId   String
  itemType  OrderItemType
  itemId    String
  title     String
  quantity  Int           @default(1)
  unitPrice Float

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model InquiryRequest {
  id           String        @id @default(cuid())
  type         InquiryType
  contactName  String
  contactEmail String
  contactPhone String?
  message      String
  details      Json?
  status       InquiryStatus @default(new)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
}

model Favorite {
  id        String        @id @default(cuid())
  userId    String
  itemType  OrderItemType
  itemId    String
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
