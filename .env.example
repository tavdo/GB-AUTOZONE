# Database (PostgreSQL)
# Use a standard postgres:// or postgresql:// connection string.
# In Georgia / production you may use Supabase, Neon, Railway, or self-hosted Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gb_autozone?schema=public"

# Set to "true" to use built-in seed/mock catalog without a live database
USE_MOCK_DATA="true"

# NextAuth
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@gbautozone.ge"
ADMIN_PASSWORD="changeme"
# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (test mode placeholder)
# Note for Georgia: production may need TBC ePay or BOG Pay instead of / in addition to Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# S3-compatible storage (Cloudinary, AWS S3, Cloudflare R2, MinIO)
S3_ENDPOINT="https://xxx.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="gb-autozone"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL="https://cdn.example.com"

# Email (Resend / SendGrid)
RESEND_API_KEY=""
EMAIL_FROM="orders@gbautozone.ge"

# Contact / chat
NEXT_PUBLIC_WHATSAPP_NUMBER="9955XXXXXXXX"
NEXT_PUBLIC_TELEGRAM_USERNAME="gbautozone"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_PHONE="+995 XXX XX XX XX"

# Analytics
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_FB_PIXEL_ID=""
