# Local development (mock) OR Turso
USE_MOCK_DATA="true"

# Local Prisma migrate target (SQLite file)
DATABASE_URL="file:./prisma/dev.db"
MIGRATE_DATABASE_URL="file:./prisma/dev.db"

# Turso (libSQL) — set both to disable mock and use the cloud DB
TURSO_DATABASE_URL="libsql://gb-autozone-tavdo.aws-ap-northeast-1.turso.io"
TURSO_AUTH_TOKEN=""

# NextAuth
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@gbautozone.ge"
ADMIN_PASSWORD="changeme"

# Contact
NEXT_PUBLIC_WHATSAPP_NUMBER="9955XXXXXXXX"
NEXT_PUBLIC_TELEGRAM_USERNAME="gbautozone"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_PHONE="+995 XXX XX XX XX"
